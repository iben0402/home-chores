# Copy to .env.local and fill in from Firebase console → Project settings → Your apps.
# Required for `npm run build` (the build fails if API_KEY, PROJECT_ID or APP_ID is missing).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# In dev (`npm run dev`), the app uses the local emulators with the demo-home-chores project,
# ignoring the values above. Set to "false" to run dev against the real project instead.
# Production builds never use the emulators.
VITE_USE_EMULATORS=true
