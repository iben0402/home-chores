rules_version = '2';

// Chours security rules. All authorisation lives here (there is no server).
// Design: docs/superpowers/specs/2026-11-24-home-chores-design.md §10.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function household(hid) { return /databases/$(database)/documents/households/$(hid); }
    function memberDoc(hid, uid) { return /databases/$(database)/documents/households/$(hid)/members/$(uid); }
    function isMember(hid) { return exists(memberDoc(hid, me())); }
    // Admin powers need both: listed in adminUids AND still a member.
    function isAdmin(hid) { return me() in get(household(hid)).data.adminUids && isMember(hid); }
    // As it will be after this write/batch (a new household's room, code and invite go in one batch).
    function isAdminAfter(hid) {
      return me() in getAfter(household(hid)).data.adminUids && existsAfter(memberDoc(hid, me()));
    }
    function creatingHousehold(hid) {
      return !exists(household(hid)) && getAfter(household(hid)).data.createdBy == me();
    }
    function validName(name) { return name is string && name.trim().size() > 0 && name.size() <= 80; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function activeInviteFor(code, hid) {
      let invite = get(invitePath(code)).data;
      return invite.get('householdId', '') == hid && invite.active == true;
    }
    // adminUids: non-empty, no duplicates, and at most one newcomer per write, who must be a member.
    function validAdminChange() {
      let next = request.resource.data.adminUids;
      let added = next.removeAll(resource.data.adminUids);
      return next is list && next.size() > 0 && next.toSet().size() == next.size()
        && (added.size() == 0 || (added.size() == 1 && added[0] is string
            && exists(memberDoc(request.resource.id, added[0]))));
    }

    match /households/{hid} {
      // Any signed-in user may read a household by ID: the join preview (spec §8.7). It holds no
      // invite code (that is in private/invite, members only). No listing.
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'adminUids', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == me()
        && request.resource.data.adminUids == [me()]
        && validName(request.resource.data.name)
        && existsAfter(memberDoc(hid, me()))
        && existsAfter(/databases/$(database)/documents/households/$(hid)/private/invite);
      allow update: if signedIn() && isAdmin(hid)
        && onlyChanged(['name', 'adminUids'])
        && validName(request.resource.data.name)
        && validAdminChange();

      match /members/{memberId} {
        // Join preview: signed-in users may see who is in a household (names, colours; no codes, no emails).
        allow read: if signedIn();
        allow create: if signedIn()
          && memberId == me()
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'color', 'joinedAt', 'photoURL'])
          && request.resource.data.uid == me()
          && validName(request.resource.data.displayName)
          && request.resource.data.color is int
          && request.resource.data.color >= 1 && request.resource.data.color <= 10
          && request.resource.data.joinedAt == request.time
          && (creatingHousehold(hid)
              || activeInviteFor(getAfter(/databases/$(database)/documents/households/$(hid)/joins/$(me())).data.inviteCode, hid));
        allow update: if signedIn() && memberId == me()
          && onlyChanged(['displayName', 'photoURL'])
          && validName(request.resource.data.displayName);
        // Leave (self) or remove (admin). An admin must come off adminUids in the same batch,
        // and the last admin can't (adminUids may never be empty), so no household loses its admins.
        allow delete: if signedIn()
          && (memberId == me() || isAdmin(hid))
          && !(memberId in getAfter(household(hid)).data.adminUids);
      }

      // Proof of the code someone joined with. Private: never on the public member doc.
      match /joins/{joinerId} {
        allow read: if signedIn() && isAdmin(hid);
        allow create, update: if signedIn() && joinerId == me()
          && request.resource.data.keys().hasOnly(['inviteCode'])
          && request.resource.data.inviteCode is string;
      }

      // The current invite code: members only. Must point at this household's active invite.
      match /private/{docId} {
        allow read: if signedIn() && isMember(hid);
        allow create, update: if signedIn() && docId == 'invite' && isAdminAfter(hid)
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code is string
          && getAfter(invitePath(request.resource.data.code)).data.householdId == hid
          && getAfter(invitePath(request.resource.data.code)).data.active == true;
      }

      // ---- Chores (spec §8, §10). Members: one-offs only; admins: anything. ----
      // Occurrence ids are `{choreId}_{seq}`, so a tick or an undo can name exactly what it adds or removes.
      function chorePath(choreId) { return /databases/$(database)/documents/households/$(hid)/chores/$(choreId); }
      function occPath(occId) { return /databases/$(database)/documents/households/$(hid)/occurrences/$(occId); }
      function occIdFor(choreId, seq) { return choreId + '_' + string(seq); }
      function roomExists(roomId) { return roomId is string && exists(/databases/$(database)/documents/households/$(hid)/rooms/$(roomId)); }
      function validISO(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
      // Names shown in History and on chores are your current member name, not anything you type.
      function myName() { return get(memberDoc(hid, me())).data.displayName; }

      match /chores/{choreId} {
        // The tick being recorded: I complete one of this chore's open occurrences in this same write.
        function validTick(t) {
          let before = get(occPath(t.occurrenceId)).data;
          let after = getAfter(occPath(t.occurrenceId)).data;
          return t.keys().hasOnly(['occurrenceId', 'by', 'toppedUp', 'previousDates', 'previousLastDoneAt'])
            && t.by == me() && t.previousDates is list && t.previousDates.size() <= 8
            && t.previousLastDoneAt == resource.data.get('lastDoneAt', null)
            && before.choreId == choreId && before.status == 'open'
            && after.status == 'done' && after.doneBy == me() && after.doneAt == request.time;
        }
        // Undoing the chore's last tick, which was mine: that occurrence is reopened in this same write.
        function undoingMyTick() {
          let t = resource.data.get('lastTick', null);
          return t != null && t.by == me()
            && request.resource.data.lastTick == null
            && request.resource.data.lastDoneAt == t.previousLastDoneAt
            && get(occPath(t.occurrenceId)).data.status == 'done'
            && getAfter(occPath(t.occurrenceId)).data.status == 'open';
        }
        function ticking() {
          return resource.data.kind != 'oneoff' && resource.data.archived == false
            && request.resource.data.lastDoneAt == request.time
            && validTick(request.resource.data.lastTick);
        }

        allow read: if signedIn() && isMember(hid);
        allow create: if signedIn() && isMember(hid)
          && request.resource.data.keys().hasOnly(['title', 'description', 'roomId', 'kind', 'interval', 'calendar', 'lookahead', 'nextSeq', 'archived', 'createdBy', 'createdByName', 'createdAt'])
          && validName(request.resource.data.title)
          && request.resource.data.description is string && request.resource.data.description.size() <= 1000
          && roomExists(request.resource.data.roomId)
          && request.resource.data.kind in ['oneoff', 'interval', 'calendar']
          && request.resource.data.archived == false
          && request.resource.data.createdBy == me()
          && request.resource.data.createdByName == myName()
          && request.resource.data.createdAt == request.time
          && request.resource.data.nextSeq is int && request.resource.data.lookahead is int
          && request.resource.data.lookahead >= 1 && request.resource.data.lookahead <= 8
          && (isAdmin(hid) || (request.resource.data.kind == 'oneoff' && request.resource.data.nextSeq == 1));
        allow update: if signedIn() && isMember(hid) && (
          isAdmin(hid)
          // The creator of a one-off may edit its words and room.
          || (resource.data.kind == 'oneoff' && resource.data.createdBy == me()
              && onlyChanged(['title', 'description', 'roomId']) && validName(request.resource.data.title)
              && roomExists(request.resource.data.roomId))
          // Tick that tops the queue up: the counter moves on by one, to exactly the occurrence added now.
          || (ticking() && onlyChanged(['nextSeq', 'lastDoneAt', 'lastTick'])
              && request.resource.data.nextSeq == resource.data.nextSeq + 1
              && request.resource.data.lastTick.toppedUp == occIdFor(choreId, resource.data.nextSeq)
              && !exists(occPath(request.resource.data.lastTick.toppedUp))
              && existsAfter(occPath(request.resource.data.lastTick.toppedUp)))
          // Tick with a full queue: nothing added.
          || (ticking() && onlyChanged(['lastDoneAt', 'lastTick'])
              && request.resource.data.lastTick.toppedUp == null)
          // Undo that removes the occurrence the tick added: the counter moves back by one.
          || (undoingMyTick() && onlyChanged(['nextSeq', 'lastDoneAt', 'lastTick'])
              && request.resource.data.nextSeq == resource.data.nextSeq - 1
              && resource.data.lastTick.toppedUp == occIdFor(choreId, request.resource.data.nextSeq)
              && !existsAfter(occPath(resource.data.lastTick.toppedUp)))
          // Undo that keeps it (someone took it, or nothing was added).
          || (undoingMyTick() && onlyChanged(['lastDoneAt', 'lastTick']))
        );
        allow delete: if signedIn() && (isAdmin(hid) || (isMember(hid) && resource.data.kind == 'oneoff' && resource.data.createdBy == me()));
      }

      match /occurrences/{occId} {
        function chore() { return get(chorePath(resource.data.choreId)).data; }
        function newOccurrenceFields() {
          let o = request.resource.data;
          return o.keys().hasOnly(['choreId', 'choreTitle', 'roomId', 'kind', 'seq', 'dueDate', 'status', 'assigneeUid', 'assignedBy', 'createdBy', 'createdByName'])
            && o.status == 'open' && o.seq is int && o.seq >= 0 && validISO(o.dueDate)
            && occId == occIdFor(o.choreId, o.seq)
            // Signed as me; an admin resizing someone else's chore keeps its creator.
            && ((o.createdBy == me() && o.createdByName == myName()) || (isAdmin(hid) && o.createdBy is string))
            // Unassigned, or (a new chore's first one) assigned by me to a member.
            && (o.assigneeUid == null || (o.assignedBy == me() && o.assigneeUid is string && exists(memberDoc(hid, o.assigneeUid))));
        }
        // Matches its chore (as it is after this write).
        function matchesChore(c) {
          let o = request.resource.data;
          return o.kind == c.kind && o.roomId == c.roomId && o.choreTitle == c.title;
        }
        function firstOccurrence() {
          let c = getAfter(chorePath(request.resource.data.choreId)).data;
          return !exists(chorePath(request.resource.data.choreId))
            && c.createdBy == me() && request.resource.data.seq < c.nextSeq && matchesChore(c);
        }
        function topUp() {
          let c = get(chorePath(request.resource.data.choreId)).data;
          return request.resource.data.assigneeUid == null
            && c.kind != 'oneoff' && c.archived == false && matchesChore(c)
            && request.resource.data.seq == c.nextSeq
            && getAfter(chorePath(request.resource.data.choreId)).data.nextSeq == request.resource.data.seq + 1;
        }
        allow read: if signedIn() && isMember(hid);
        allow create: if signedIn() && isMember(hid) && newOccurrenceFields() && (
          isAdmin(hid) || firstOccurrence() || topUp()
        );
        allow update: if signedIn() && isMember(hid) && (
          isAdmin(hid)
          // Complete: as yourself, at server time.
          || (resource.data.status == 'open' && request.resource.data.status == 'done'
              && onlyChanged(['status', 'doneBy', 'doneByName', 'doneAt'])
              && request.resource.data.doneBy == me() && request.resource.data.doneAt == request.time
              && request.resource.data.doneByName == myName())
          // Re-date an open occurrence (completing an "after it's done" chore moves the queue).
          || (resource.data.status == 'open' && onlyChanged(['dueDate']) && validISO(request.resource.data.dueDate))
          // Assign (spec §8.4): anyone may give an open occurrence to any member, signed as themselves.
          || (resource.data.status == 'open'
              && onlyChanged(['assigneeUid', 'assignedBy'])
              && request.resource.data.assignedBy == me()
              && request.resource.data.assigneeUid is string
              && exists(memberDoc(hid, request.resource.data.assigneeUid)))
          // Unassign yourself (only admins may unassign someone else).
          || (resource.data.status == 'open' && resource.data.assigneeUid == me()
              && onlyChanged(['assigneeUid', 'assignedBy'])
              && request.resource.data.assigneeUid == null && request.resource.data.assignedBy == me())
          // The creator of a one-off edits its open occurrence: words, room, date.
          || (resource.data.status == 'open' && chore().kind == 'oneoff' && chore().createdBy == me()
              && onlyChanged(['choreTitle', 'roomId', 'dueDate'])
              && validName(request.resource.data.choreTitle) && roomExists(request.resource.data.roomId)
              && validISO(request.resource.data.dueDate))
          // Undo your own tick within 10 minutes.
          || (resource.data.status == 'done' && resource.data.doneBy == me()
              && request.time < resource.data.doneAt + duration.value(10, 'm')
              && request.resource.data.status == 'open'
              && onlyChanged(['status', 'doneBy', 'doneByName', 'doneAt'])
              && !request.resource.data.keys().hasAny(['doneBy', 'doneByName', 'doneAt']))
        );
        allow delete: if signedIn() && isMember(hid) && (
          isAdmin(hid)
          // The creator of a one-off deletes it (with the chore).
          || (resource.data.status == 'open' && chore().kind == 'oneoff' && chore().createdBy == me()
              && !existsAfter(chorePath(resource.data.choreId)))
          // Undoing my last tick removes the occurrence it added, if still open and unassigned.
          || (resource.data.status == 'open' && resource.data.assigneeUid == null
              && chore().get('lastTick', null) != null
              && chore().lastTick.toppedUp == occId && chore().lastTick.by == me()
              && getAfter(chorePath(resource.data.choreId)).data.nextSeq == resource.data.seq)
        );
      }

      match /rooms/{roomId} {
        allow read: if signedIn() && isMember(hid);
        // Only the household's first room (General) is the default.
        allow create: if signedIn() && isAdminAfter(hid)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'order', 'isDefault'])
          && validName(request.resource.data.name)
          && (request.resource.data.get('isDefault', false) == false || creatingHousehold(hid));
        allow update: if signedIn() && isAdmin(hid)
          && onlyChanged(['name', 'icon', 'order'])
          && validName(request.resource.data.name);
        allow delete: if signedIn() && isAdmin(hid) && resource.data.get('isDefault', false) != true;
      }
    }

    // In-app notifications (spec §8.10). Only the recipient reads, marks read or deletes them.
    // Anyone may send one to another member of a household they're in, signed with their own
    // member name and colour and the household's real name.
    match /users/{uid}/notifications/{nid} {
      function validNotification() {
        let n = request.resource.data;
        let hid = n.householdId;
        let sender = get(memberDoc(hid, me())).data;
        return n.keys().hasAll(['type', 'householdId', 'householdName', 'choreId', 'choreTitle', 'fromUid', 'fromName', 'fromColor', 'read', 'createdAt'])
          && n.keys().hasOnly(['type', 'householdId', 'householdName', 'choreId', 'occurrenceId', 'choreTitle', 'previousTitle', 'dueDate', 'fromUid', 'fromName', 'fromColor', 'read', 'createdAt'])
          && n.type in ['assigned', 'changed', 'renamed', 'removed']
          && n.read == false && n.createdAt == request.time && n.fromUid == me()
          && hid is string && n.choreId is string && validName(n.choreTitle)
          && n.get('occurrenceId', '') is string
          && (n.get('previousTitle', null) == null || validName(n.previousTitle))
          && (n.get('dueDate', null) == null || (n.dueDate is string && n.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && exists(memberDoc(hid, uid))
          && n.fromName == sender.displayName && n.fromColor == sender.color
          && n.householdName == get(household(hid)).data.name;
      }
      allow read, delete: if signedIn() && uid == me();
      allow update: if signedIn() && uid == me() && onlyChanged(['read']) && request.resource.data.read == true;
      allow create: if signedIn() && uid != me() && validNotification();
    }

    // "My households": a collection-group query for my own member docs.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    match /invites/{code} {
      // Look up a code you were given, signed in or not (the invite-link screen shows the
      // household name before log-in). Never list them: codes are only known to whoever got one.
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId', 'householdName', 'active', 'createdBy', 'createdAt'])
        && request.resource.data.active == true
        && request.resource.data.createdBy == me()
        && validName(request.resource.data.householdName)
        && isAdminAfter(request.resource.data.householdId)
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)/private/invite).data.code == code;
      allow update: if signedIn() && resource.data.active == true && isAdmin(resource.data.householdId) && (
        // Rename: only the copy of the household name changes.
        (onlyChanged(['householdName']) && validName(request.resource.data.householdName))
        // Retire: becomes inactive for good and forgets which household it was for.
        || (request.resource.data.keys().hasOnly(['active', 'createdBy', 'createdAt'])
            && request.resource.data.active == false
            && request.resource.data.createdBy == resource.data.createdBy)
      );
    }
  }
}
